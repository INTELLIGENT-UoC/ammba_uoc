# AMMBA environment. Copy to .env and adjust. Docker Compose reads .env and
# passes these variables to the clearing node; outside Compose, export them in
# the shell. Environment variables override amm-clearing-node/configuration.yaml,
# and an empty value counts as unset. Reference: docs/reference/configuration.md

# ── Transport ────────────────────────────────────────────────────────
# "rest": direct off-chain store API (default; also the local simulator)
# "ewds": publish/poll through an EWDS Client Gateway
OFFCHAIN_TRANSPORT=rest

# Off-chain store base URL, used by the "rest" transport. This value targets
# the bundled simulator (docker compose --profile dev up).
OFFCHAIN_DB_URL=http://offchain-db-sim:8080

# ── EWDS gateway (only for OFFCHAIN_TRANSPORT=ewds) ──────────────────
# Gateway URL provided by the deployment operator. The other values default to
# the GSY DEX conventions and rarely need changing.
EWDS_GATEWAY_URL=http://ewds-gateway-api:3333
# EWDS_TOPIC_OWNER=integration.apps.intelligent.auth.ewc
# EWDS_TOPIC_VERSION=1.0.0
# EWDS_REQUEST_PUBLISH_FQCN=gsy.intelligent.requests.pub      # alias: EWDS_REQUEST_FQCN
# EWDS_RESPONSE_SUBSCRIBE_FQCN=gsy.intelligent.responses.sub  # alias: EWDS_RESPONSE_FQCN
# EWDS_AMM_CLIENT_ID=ammclearingnode   # base of the per-topic consumer ids; alias: EWDS_RESPONSE_CLIENT_ID
# EWDS_RESPONSE_TIMEOUT_MS=60000
# EWDS_RESPONSE_POLL_INTERVAL_MS=1000         # first response-poll delay
# EWDS_RESPONSE_POLL_MAX_INTERVAL_MS=5000     # ceiling of the polling back-off

# ── Inbound order validation ─────────────────────────────────────────
# true: drop orders that fail int:Order validation; false: keep them, log only
OFFCHAIN_STRICT_VALIDATION=true

# ── Self-trigger scheduler ───────────────────────────────────────────
# Discover closed AMM markets and clear them without an external trigger.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SEC=60

# ── Market and HTTP API ──────────────────────────────────────────────
# TIME_SLOT_SEC=900
# HOST=0.0.0.0     # only for `python -m src.main`; uvicorn and the image take --host/--port
# PORT=8081

# ── Optional on-chain audit anchor ───────────────────────────────────
# Leave CONTRACT_ADDRESS empty to run off-chain; the anchor is used only when
# both CONTRACT_ADDRESS and CLEARING_NODE_PRIVATE_KEY are set.
RPC_URL=https://volta-rpc.energyweb.org
CONTRACT_ADDRESS=
# Dedicated, funded account. NEVER commit a real key.
CLEARING_NODE_PRIVATE_KEY=

# ── Contract deployment (amm-smart-contract) ─────────────────────────
# Hardhat does not read this file: export these before `npx hardhat run`.
DEPLOYER_PRIVATE_KEY=
# Address allowed to call clearMarket (the clearing node's account).
CLEARING_NODE_ADDRESS=

# ── Settlement engine (amm-execution-node, --execute only) ───────────
# The dry-run planner needs none of these.
# SETTLEMENT_RPC_URL=
# ORDER_REGISTRY_ADDRESS=
# TRADE_SETTLEMENT_ADDRESS=
# SETTLEMENT_PRIVATE_KEY=
