# AMMBA environment. Copy to .env and adjust. Environment variables override
# amm-clearing-node/configuration.yaml. Reference: docs/reference/configuration.md

# ── Transport ────────────────────────────────────────────────────────
# "rest": direct off-chain store API (default; also the local simulator)
# "ewds": publish/poll through an EWDS Client Gateway
OFFCHAIN_TRANSPORT=rest

# Off-chain store base URL, used by the "rest" transport
OFFCHAIN_DB_URL=http://offchain-db:8080

# ── EWDS gateway (only for OFFCHAIN_TRANSPORT=ewds) ──────────────────
# Gateway URL provided by the deployment operator. The other values default to
# the GSY DEX conventions and rarely need changing.
EWDS_GATEWAY_URL=http://ewds-gateway-api:3333
# EWDS_TOPIC_OWNER=integration.apps.intelligent.auth.ewc
# EWDS_TOPIC_VERSION=1.0.0
# EWDS_AMM_CLIENT_ID=ammclearingnode          # base of the per-topic consumer ids
# EWDS_RESPONSE_TIMEOUT_MS=60000
# EWDS_RESPONSE_POLL_INTERVAL_MS=1000         # first response-poll delay
# EWDS_RESPONSE_POLL_MAX_INTERVAL_MS=5000     # ceiling of the polling back-off

# ── Inbound order validation ─────────────────────────────────────────
# true: drop orders that fail int:Order validation; false: keep them, log only
OFFCHAIN_STRICT_VALIDATION=true

# ── Self-trigger scheduler ───────────────────────────────────────────
# Discover closed AMM markets and clear them without an external trigger.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_INTERVAL_SEC=60

# ── Optional on-chain audit anchor ───────────────────────────────────
# Leave CONTRACT_ADDRESS and CLEARING_NODE_PRIVATE_KEY empty to run off-chain.
RPC_URL=https://volta-rpc.energyweb.org
CONTRACT_ADDRESS=
# Dedicated, funded account. NEVER commit a real key.
CLEARING_NODE_PRIVATE_KEY=

# Key used by the Hardhat deploy script (amm-smart-contract)
DEPLOYER_PRIVATE_KEY=
