# Energy Web Chain RPC (Volta testnet by default)
RPC_URL=https://volta-rpc.energyweb.org

# Deployed AMMContract address (set after deployment)
CONTRACT_ADDRESS=

# Private key used by the Clearing Node to submit clearMarket() txs.
# Use a dedicated funded account. NEVER commit a real key.
CLEARING_NODE_PRIVATE_KEY=

# Private key used by the Hardhat deploy script.
DEPLOYER_PRIVATE_KEY=

# Off-chain transport: "rest" (direct off-chain DB API / local simulator) or
# "ewds" (publish/poll via the EW CGW gateway — the GSY-confirmed path).
OFFCHAIN_TRANSPORT=rest

# Off-chain DB (GSY DEX) base URL — used by the "rest" transport
OFFCHAIN_DB_URL=http://offchain-db:8080

# EWDS gateway settings — used by the "ewds" transport. Defaults mirror GSY's
# client; only the gateway URL usually needs setting per environment.
EWDS_GATEWAY_URL=http://ewds-gateway-api:3333
# EWDS_TOPIC_OWNER=integration.apps.intelligent.auth.ewc
# EWDS_TOPIC_VERSION=1.0.0
# EWDS_AMM_CLIENT_ID=ammclearingnode
# EWDS_RESPONSE_TIMEOUT_MS=60000
# EWDS_RESPONSE_POLL_INTERVAL_MS=400

# Keep inbound orders that fail int:Order validation (log-only). Set to false
# against the GSY staging gateway until their DTOs match the ontology.
# OFFCHAIN_STRICT_VALIDATION=true

# Self-trigger scheduler: discover closed AMM markets via the market list and
# clear them without an external trigger (GSY: no market-close event exists).
SCHEDULER_ENABLED=false
# SCHEDULER_POLL_INTERVAL_SEC=60
